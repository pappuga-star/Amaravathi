{
  "name": "amaravathi-tea-pricing",
  "version": "1.0.0",
  "private": true,
  "description": "Amaravathi Tea Pricing System monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,admin -c blue,green \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "npm --workspace @amaravathi/api run dev",
    "dev:admin": "npm --workspace @amaravathi/admin-web run dev",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "npm run build --workspace=@amaravathi/shared-types && npm run build --workspace=@amaravathi/shared-ui && npm run build --workspace=@amaravathi/shared-utils && npm run build --workspace=@amaravathi/admin-web",
    "start": "npm --workspace @amaravathi/api run start",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplicates": "jscpd . --ignore \"**/node_modules/**,**/dist/**,**/package-lock.json\"",
    "duplicates:ci": "jscpd . --threshold 5.3 --ignore \"**/node_modules/**,**/dist/**,**/package-lock.json\"",
    "dead-code": "knip --no-exit-code",
    "dead-code:ci": "knip",
    "circular": "madge --circular apps packages",
    "security": "npm audit --production",
    "a11y:icon-buttons": "node scripts/check-accessible-icon-buttons.mjs",
    "quality:pr": "npm run typecheck && npm run lint && npm run a11y:icon-buttons && npm run dead-code:ci && npm run duplicates:ci",
    "quality": "npm run format:check && npm run lint && npm run a11y:icon-buttons && npm run test && npm run build && npm run duplicates && npm run dead-code && npm run circular",
    "test:search:unit": "npm --workspace @amaravathi/api run test -- src/search/tests/search.unit.test.ts",
    "test:search:integration": "npm --workspace @amaravathi/api run test -- src/search/tests/search.integration.test.ts",
    "test:search:frontend": "npm --workspace @amaravathi/admin-web run test -- src/search/tests/search.components.test.tsx",
    "test:search:e2e": "npm --workspace @amaravathi/admin-web run test:ui -- ../../tests/e2e/search/search.e2e.spec.ts",
    "search:ssot:verify": "node scripts/verify-search-ssot.mjs",
    "search:benchmark:regression": "node scripts/search-benchmark-regression-check.mjs",
    "search:release:check": "node scripts/search-release-check.mjs",
    "search:quality:all": "npm run test:search:unit && npm run test:search:integration && npm run test:search:frontend && npm run search:ssot:verify && npm run search:benchmark:regression && npm run search:release:check"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jscpd": "^4.2.3",
    "knip": "^6.14.1",
    "madge": "^8.0.0",
    "prettier": "^3.3.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.3"
  }
}
