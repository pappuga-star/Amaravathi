{
  "name": "amaravathi-tea-pricing",
  "version": "1.0.0",
  "private": true,
  "description": "Amaravathi Tea Pricing System monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,admin -c blue,green \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "npm --workspace @amaravathi/api run dev",
    "dev:admin": "npm --workspace @amaravathi/admin-web run dev",
    "build": "npm run build --workspaces --if-present",
    "start": "npm --workspace @amaravathi/api run start",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplicates": "jscpd . --ignore \"**/node_modules/**,**/dist/**,**/package-lock.json\"",
    "duplicates:ci": "jscpd . --threshold 5.3 --ignore \"**/node_modules/**,**/dist/**,**/package-lock.json\"",
    "dead-code": "knip --no-exit-code",
    "dead-code:ci": "knip",
    "circular": "madge --circular apps packages",
    "security": "npm audit --production",
    "quality:pr": "npm run typecheck && npm run lint && npm run dead-code:ci && npm run duplicates:ci",
    "quality": "npm run format:check && npm run lint && npm run test && npm run build && npm run duplicates && npm run dead-code && npm run circular"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jscpd": "^4.2.3",
    "knip": "^6.14.1",
    "madge": "^8.0.0",
    "prettier": "^3.3.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.3"
  }
}
