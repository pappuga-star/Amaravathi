{
  "name": "amaravathi-tea-pricing",
  "version": "1.0.0",
  "private": true,
  "description": "Amaravathi Tea Pricing System monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin -c blue,green \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "npm --workspace @amaravathi/api run dev",
    "dev:admin": "npm --workspace @amaravathi/admin-web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  }
}
