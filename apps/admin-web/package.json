    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.25.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "^1.54.1",
